APP_NAME=Cyber Security Threat Pipeline  # Name of the service.  
API_HOST=0.0.0.0  # Host for FastAPI.  
API_PORT=8000  # Port for FastAPI.  
KAFKA_BOOTSTRAP_SERVERS=kafka:9092  # Kafka broker address.  
KAFKA_TOPIC=security-events  # Topic used for incoming events.  
REDIS_HOST=redis  # Redis host name.  
REDIS_PORT=6379  # Redis port.  
OPENSEARCH_HOST=opensearch  # OpenSearch host.  
OPENSEARCH_PORT=9200  # OpenSearch port.  
OPENSEARCH_INDEX=security-events  # Index for logs and incidents.  
OLLAMA_BASE_URL=http://host.docker.internal:11434  # Ollama server URL.  
OLLAMA_MODEL=qwen3:8b  # Local LLM model for triage.  
LLM_RATE_LIMIT_PER_MINUTE=20  # Limit LLM calls so costs and load stay controlled.
